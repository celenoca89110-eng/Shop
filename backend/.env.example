# --- Serveur ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Base de données ---
# En production sur Render, DATABASE_URL est fourni automatiquement
# par le service PostgreSQL lié (à copier dans les variables d'env Render).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cecashop
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cecashop

# --- JWT ---
# Générez des secrets forts avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_moi_en_production
JWT_REFRESH_SECRET=change_moi_aussi_en_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# --- Compte Founder (accès total, protégé, jamais supprimable) ---
FOUNDER_EMAIL=celenoca.ytb@gmail.com
FOUNDER_DISCORD_ID=1112038418629808148

# --- Stripe (Phase 2) ---
# Récupérez ces clés sur https://dashboard.stripe.com/apikeys (mode test d'abord)
STRIPE_SECRET_KEY=sk_test_xxx
# Générée par `stripe listen --forward-to localhost:4000/api/stripe/webhook` en local,
# ou par le endpoint webhook créé dans le dashboard Stripe en production.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Discord (Phase 4) ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
